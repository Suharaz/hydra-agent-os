# ---- Mode ---------------------------------------------------------------
# demo | live. demo derives: SPOT=testnet FUTURES=demo ONCHAIN=paper X402=mock MCP=off
HYDRA_MODE=demo
# Required when HYDRA_MODE=live (or any venue flag set to live)
HYDRA_I_UNDERSTAND_REAL_MONEY=0

# ---- Per-venue overrides (optional; default derived from HYDRA_MODE) ----
# SPOT=testnet|live
# FUTURES=demo|live
# ONCHAIN=paper|live
# X402=mock|b402|cdp
# MCP=off|on

# ---- Binance keys (optional in demo, required in live) -----------------
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ---- Encrypted secret store (UI-managed keys) --------------------------
# Master passphrase that decrypts state/secrets.enc at boot. Set this and manage every API key from
# the operator dashboard (panel 12, AES-256-GCM). Keys entered in the UI apply on the next restart.
# When unset, secrets.enc (if present) is NOT loaded and keys must come from the env vars below.
HYDRA_MASTER_PASSPHRASE=

# ---- Dashboard (127.0.0.1 only) ----------------------------------------
# Operator token (full control). >= 24 characters.
# live: required. demo: generated and printed once at boot when absent.
DASHBOARD_TOKEN=
# Optional viewer token: read-only role (GET + live stream, no logs, no writes) for
# presentations / screen-share. >= 24 characters and must differ from DASHBOARD_TOKEN.
# DASHBOARD_VIEWER_TOKEN=
DASHBOARD_PORT=8787

# ---- x402 seller ---------------------------------------------------------
X402_PORT=8788
# demo buyer signer (LocalSigner); never a funded key
X402_DEMO_PRIVATE_KEY=

# ---- LLM agents ----------------------------------------------------------
OPENROUTER_API_KEY=
# Per-agent model override: HYDRA_MODEL_COMMANDER, HYDRA_MODEL_SUPERVISOR, HYDRA_MODEL_TREASURER, HYDRA_MODEL_COACH, HYDRA_MODEL_SALES
# HYDRA_MODEL_COMMANDER=anthropic/claude-fable-5.1

# ---- Alerts --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic HTTP POST fallback (JSON body {level, msg, ts})
ALERT_WEBHOOK_URL=

# ---- On-chain (live only) -----------------------------------------------
# Absolute path to the pinned @binance/agentic-wallet `baw` binary
BAW_BIN=

# ---- Misc ----------------------------------------------------------------
# Kill switch flattens ALL spot base assets, not only engine-attributed ones
KILL_FLATTEN_ALL_SPOT=0
# Replay speed multiplier for `cli replay`
REPLAY_SPEED=1
# Skills Hub public HTTP base URL
SKILLS_HTTP=https://web3.binance.com
